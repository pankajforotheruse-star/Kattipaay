; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not obvious.
;
; Format: Godot 4.x
[application]
config/name="Chalk Gaon: Ghost Lines (Prototype)"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"
[autoload]
EventBus="*res://scripts/autoload/EventBus.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
InputManager="*res://scripts/autoload/InputManager.gd"
NetworkManager="*res://scripts/autoload/NetworkManager.gd"
GameState="*res://scripts/autoload/GameState.gd"
SceneManager="*res://scripts/autoload/SceneManager.gd"
MatchTimer="*res://scripts/autoload/MatchTimer.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
ScoringManager="*res://scripts/autoload/ScoringManager.gd"
ProfilerOverlay="*res://scripts/debug/ProfilerOverlay.gd"
[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
[input_devices]
pointing/emulate_touch_from_mouse=true

[chalk_gaon]
; Play VS CPU round pacing (slice 3, R6). Owner default: draw 40s, meeting ~15s,
; each search phase 30s. The smoke test overrides these to short values via
; ProjectSettings.set_setting() so the CI headless run stays well under 90s.
solo_drawing_seconds=40.0
solo_meeting_call_timeout_seconds=8.0
solo_meeting_max_seconds=15.0
solo_coin_result_hold_seconds=2.0
solo_meeting_flip_duration=2.0
solo_search_phase_seconds=30.0
solo_early_exit_grace_seconds=1.0
solo_empty_phase_grace_seconds=1.0
solo_winner_hold_seconds=3.0
cpu_sweep_speed=420.0
; Defender argue/distract + sneak (slice 4, R6): the defender can argue once per
; phase (stalls the CPU's sweep) and sneak-draw extra lines while the CPU
; searches; the CPU notices sneaks probabilistically (chance per difficulty,
; override -1 = per-difficulty default).
solo_argue_stall_seconds=3.0
solo_argue_uses_per_phase=1
cpu_argue_chance=0.5
solo_sneak_max_lines=3
cpu_sneak_notice_chance=-1.0
[importer_defaults]
texture={
"compress/mode": 2,
"mipmaps/generate": false,
"process/fix_alpha_border": true,
"detect_3d/compress_to": 0
}
[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
