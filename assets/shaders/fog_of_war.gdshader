// fog_of_war.gdshader — Canvas item shader for the fog of war overlay
// Samples a reveal texture (ViewportTexture) to determine per-pixel fog density.
// Three-tier fog: clear (active vision) / dim (explored) / dense (unexplored).
// Supports ghost pulse flashes and chalk-line visibility modulation.
//
// Mobile GPU friendly: single texture sample, no loops, branch-lite.

shader_type canvas_item;

// Reveal texture — white=pixels are revealed, black=pixels are hidden.
// Generated by SubViewport + RevealDrawer.
uniform sampler2D reveal_texture;

// Fog appearance
uniform vec4 fog_color : source_color = vec4(0.102, 0.063, 0.188, 1.0); // #1A1030
uniform float fog_opacity : hint_range(0.0, 1.0) = 0.85;
uniform float explored_opacity : hint_range(0.0, 1.0) = 0.6;

// World-space → texture-UV transform uniforms
uniform vec2 camera_position = vec2(0.0);
uniform vec2 viewport_world_half = vec2(360.0, 640.0);
uniform vec2 world_bounds_min = vec2(0.0);
uniform vec2 world_bounds_size = vec2(2400.0, 1800.0);

// Ghost pulse effect (additive white flash)
uniform vec2 pulse_center = vec2(-10000.0);
uniform float pulse_radius = 300.0;
uniform float pulse_strength : hint_range(0.0, 1.0) = 0.0;

// Line visibility: base opacity for chalk lines in fog (modulated by DrawSystem)
uniform float line_fog_opacity : hint_range(0.0, 1.0) = 0.15;


void fragment() {
	// ── Convert screen UV → world position ──────────────────────────────
	// The fog ColorRect covers the screen, so SCREEN_UV ∈ [0,1] across the viewport.
	// camera_position is the main camera's global position.
	// viewport_world_half is how many world units the viewport spans from center to edge.
	vec2 world_pos = camera_position + (SCREEN_UV - 0.5) * viewport_world_half;

	// ── Convert world position → reveal texture UV ──────────────────────
	// The reveal texture covers the entire game world bounds.
	vec2 tex_uv = (world_pos - world_bounds_min) / world_bounds_size;
	tex_uv = clamp(tex_uv, vec2(0.0), vec2(1.0));

	// ── Sample reveal texture (single lookup) ───────────────────────────
	float reveal = texture(reveal_texture, tex_uv).r;

	// ── Three-tier fog determination ────────────────────────────────────
	// reveal > 0.8  → active vision circle (white in texture) → clear
	// reveal > 0.2  → explored but not currently visible (gray) → dim fog
	// reveal ≤ 0.2  → never explored (black) → full fog
	float fog_factor;
	if (reveal > 0.8) {
		fog_factor = 0.0;
	} else if (reveal > 0.2) {
		fog_factor = explored_opacity;
	} else {
		fog_factor = fog_opacity;
	}

	// ── Ghost pulse (additive white flash) ──────────────────────────────
	float pulse = 0.0;
	if (pulse_strength > 0.001) {
		float pulse_dist = length(world_pos - pulse_center);
		if (pulse_dist < pulse_radius) {
			// Linear falloff from center to edge
			pulse = (1.0 - pulse_dist / pulse_radius) * pulse_strength;
		}
	}

	// ── Combine ─────────────────────────────────────────────────────────
	// Base color comes from the ColorRect (white, but may be tinted by modulate).
	vec3 base = COLOR.rgb;
	vec3 fogged = mix(base, fog_color.rgb, fog_factor);
	vec3 with_pulse = mix(fogged, vec3(1.0), pulse);

	COLOR = vec4(with_pulse, 1.0);
}
